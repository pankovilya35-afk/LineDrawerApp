<Window x:Class="WpfDrawingApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Рисование линии (MVVM + PostgreSQL)" Height="600" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель управления -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <Button Content="Получить общую длину (SQL)" Command="{Binding GetTotalLengthCommand}" Margin="0,0,10,0" Padding="10,5"/>
            <Button Content="Очистить холст" Command="{Binding ClearCanvasCommand}" Padding="10,5" Background="#ffdddd"/>
            <TextBlock Text="{Binding TotalLength, StringFormat='Общая длина: {0:F2}'}" VerticalAlignment="Center" Margin="20,0,0,0" FontWeight="Bold"/>
        </StackPanel>

        <!-- Холст для рисования -->
        <!-- Background должен быть не null, иначе мышь не будет реагировать на пустом месте -->
        <Canvas x:Name="DrawingCanvas" Grid.Row="1" Background="White" 
                MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                MouseMove="Canvas_MouseMove"
                MouseLeftButtonUp="Canvas_MouseLeftButtonUp"
                ClipToBounds="True">
            <Polyline x:Name="CurrentLine" Stroke="Black" StrokeThickness="2"/>
        </Canvas>

        <!-- Статусная строка -->
        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Margin="10" FontStyle="Italic" Foreground="Gray"/>
    </Grid>
</Window>